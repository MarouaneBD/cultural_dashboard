# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Connect to Postgres directly (used by Prisma migrations)
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Session/auth DB URL (if separate from main DB)
SESSION_URL=postgresql://user:password@host:5432/postgres

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Initial admin credentials (used by prisma/seed.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# TLS certificate validation for the DB connection pool.
# Set to false ONLY for managed services that use self-signed certs (e.g. Supabase pooler).
# Omit or set to true for production environments with valid CA-signed certificates.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
