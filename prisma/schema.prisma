generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Pillar {
  EDUCATION
  FAMILY_CULTURE
  ISLAMIC_INFO_CENTER
  AL_BIRR_MALE
  AL_BIRR_FEMALE
  ORPHANS
  SCIENTIFIC_PROGRAMS
  RESEARCH_PUBLICATIONS
  HR_MANAGEMENT
  ADMIN_AFFAIRS
  PROCUREMENT
  DEVELOPMENT_PROJECTS
  ZAKAT_MANAGEMENT
}

enum KpiUnit {
  PERCENT
  COUNT
  CURRENCY
}

enum ActivityType {
  CUMULATIVE
  MONTHLY_VARIANCE
}

enum ProgramStatus {
  ON_TRACK
  AT_RISK
  COMPLETED
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum Period {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RowStatus {
  PENDING
  APPROVED
  REJECTED
  DISMISSED
}

model KpiRegistry {
  id        String    @id @default(cuid())
  nameAr    String
  pillar    Pillar
  unit      KpiUnit
  owner        String?
  slug         String?
  activityType    ActivityType @default(MONTHLY_VARIANCE)
  showInDashboard Boolean      @default(false)
  targets   Target[]
  actuals   Actual[]
  createdAt DateTime  @default(now())

  @@unique([nameAr, pillar])
}

model Target {
  id     String      @id @default(cuid())
  kpiId  String
  kpi    KpiRegistry @relation(fields: [kpiId], references: [id])
  period Period
  year   Int
  value  Float

  @@unique([kpiId, period, year])
  @@index([kpiId])
  @@index([kpiId, year, period])
}

model Actual {
  id              String      @id @default(cuid())
  kpiId           String
  kpi             KpiRegistry @relation(fields: [kpiId], references: [id])
  period          Period
  year            Int
  value           Float
  region          String?
  facility        String?
  confidenceScore Float       @default(1.0)
  createdAt       DateTime    @default(now())

  @@unique([kpiId, period, year])
  @@index([kpiId])
  @@index([kpiId, year, period])
}

model Program {
  id            String        @id @default(cuid())
  nameAr        String
  pillar        Pillar
  status        ProgramStatus
  completionPct Float         @default(0)
  budget        Float?
  updatedAt     DateTime      @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  kpiId     String?
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([kpiId])
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String?
  passwordHash       String
  role               UserRole  @default(VIEWER)
  mustChangePassword       Boolean   @default(true)
  passwordResetRequested   Boolean   @default(false)
  assignedPillarId         String?
  createdAt                DateTime  @default(now())
  comments           Comment[]
  submissions        UploadSubmission[]
}

model UploadSubmission {
  id          String           @id @default(cuid())
  submitterId String
  submitter   User             @relation(fields: [submitterId], references: [id])
  filename    String
  uploadedAt  DateTime         @default(now())
  status      SubmissionStatus @default(PENDING)
  rows        SubmissionRow[]

  @@index([submitterId])
  @@index([status])
}

model SubmissionRow {
  id           String           @id @default(cuid())
  submissionId String
  submission   UploadSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kpiId        String
  kpiNameAr    String
  period       Period
  year         Int
  newValue     Float
  oldValue     Float
  tableType    String           // "ACTUAL" or "TARGET"
  status       RowStatus        @default(PENDING)
  adminComment String?
  reviewedAt   DateTime?
  reviewedBy   String?

  @@index([submissionId])
  @@index([status])
  @@index([kpiId, period, year])
}

model Comment {
  id        String   @id @default(cuid())
  pillarId  String
  text      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pillarId])
  @@index([authorId])
}
